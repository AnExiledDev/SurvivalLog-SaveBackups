<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SaveBackups</AssemblyName>
    <RootNamespace>SaveBackups</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(Interop)\R3.dll" Private="false" />
    <Reference Include="$(Interop)\ObservableCollections.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.js" LogicalName="SaveBackups.page.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Save Backups&#10;存档备份" />
    <AssemblyMetadata Include="ModManager.Description" Value="Backs up every save each morning, when you quit, before a rebirth, an expedition or a zombie wave, at an ending and on a timer, outside Steam Cloud, with a picture of the game. The Load button opens a save manager with each survivor&apos;s portrait and a timeline of backups: compare with now, restore as a new save or in place, bring back from the bin, export and import. The pause menu gets Back up now.&#10;每天早上、退出时、重生前、探索前、尸潮前、到达结局时以及定时自动备份所有存档，备份放在 Steam 云同步之外，并附带一张游戏画面。「读取存档」按钮会打开存档管理，显示每位角色的头像和备份时间线：可以与当前对比、恢复为新存档或覆盖原存档、从回收站找回，以及导出和导入。暂停菜单新增「立即备份」。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="QualityOfLife" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20151" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-SaveBackups" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-SaveBackups/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
